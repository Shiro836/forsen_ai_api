      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "refId": "A",
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(at, INTERVAL 1 DAY) AS t, target, countIf(llm_hits > 0) / count() AS hit_rate FROM filter_runs FINAL WHERE $__timeFilter(at) AND skipped = 0 GROUP BY t, target ORDER BY t",
          "format": 1,
          "queryType": "timeseries",
          "builderOptions": {}
        }
