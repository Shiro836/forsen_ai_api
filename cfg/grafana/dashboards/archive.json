          "refId": "A",
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(at, INTERVAL 1 HOUR) AS t, engine, quantile(0.5)(first_chunk_ms)/1000 AS p50, quantile(0.95)(first_chunk_ms)/1000 AS p95 FROM tts_tracks FINAL WHERE $__timeFilter(at) AND first_chunk_ms > 0 GROUP BY t, engine ORDER BY t",
