    {
      "id": 15,
      "title": "Time per stage, avg per redeem (last 7d vs range)",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "gridPos": {
        "x": 8,
        "y": 42,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "refId": "A",
          "editorType": "sql",
          "rawSql": "SELECT handler, count() AS n, round(avg(dateDiff('millisecond', started_at, finished_at))/1000, 2) AS total_s, round(avg(llm_ms)/1000, 2) AS llm_s, round(avg(synth_ms)/1000, 2) AS tts_first_audio_s FROM (SELECT m.id, m.handler, m.started_at, m.finished_at, (SELECT sum(latency_ms) FROM llm_calls FINAL l WHERE l.msg_id = m.id) AS llm_ms, (SELECT min(first_chunk_ms) FROM tts_tracks FINAL t WHERE t.msg_id = m.id) AS synth_ms FROM messages FINAL m WHERE $__timeFilter(enqueued_at) AND outcome = 'played') GROUP BY handler ORDER BY n DESC",
          "format": 1,
          "queryType": "table",
          "builderOptions": {}
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
