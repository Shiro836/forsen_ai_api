    {
      "id": 1,
      "title": "Redeems per day, by channel",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "refId": "A",
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(enqueued_at, INTERVAL 1 DAY) AS t, channel_login, count() AS redeems FROM messages FINAL WHERE $__timeFilter(enqueued_at) AND outcome != '' GROUP BY t, channel_login ORDER BY t",
          "format": 1,
          "queryType": "timeseries",
          "builderOptions": {}
        }
      ],
      "fieldConfig": {
        "defaults": {
