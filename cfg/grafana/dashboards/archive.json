      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "refId": "A",
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(at, INTERVAL 1 DAY) AS t, model, sum(prompt_tokens) AS prompt, sum(completion_tokens) AS completion FROM llm_calls FINAL WHERE $__timeFilter(at) GROUP BY t, model ORDER BY t",
          "format": 1,
          "queryType": "timeseries",
          "builderOptions": {}
        }
      ],
