    {
      "id": 4,
      "title": "LLM latency p50 / p95, by kind",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "refId": "A",
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(at, INTERVAL 1 HOUR) AS t, kind, quantile(0.5)(latency_ms)/1000 AS p50, quantile(0.95)(latency_ms)/1000 AS p95 FROM llm_calls FINAL WHERE $__timeFilter(at) AND error = '' GROUP BY t, kind ORDER BY t",
          "format": 1,
          "queryType": "timeseries",
          "builderOptions": {}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "TTS synthesized vs played, seconds per day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "refId": "A",
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(at, INTERVAL 1 DAY) AS t, engine, sum(audio_sec) AS synthesized, sum(played_sec) AS played FROM tts_tracks FINAL WHERE $__timeFilter(at) GROUP BY t, engine ORDER BY t",
          "format": 1,
          "queryType": "timeseries",
          "builderOptions": {}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
