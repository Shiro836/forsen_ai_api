          "refId": "A",
          "editorType": "sql",
          "rawSql": "SELECT table, formatReadableSize(sum(bytes_on_disk)) AS on_disk, sum(rows) AS rows, count() AS parts FROM system.parts WHERE active AND database = currentDatabase() GROUP BY table ORDER BY table",
