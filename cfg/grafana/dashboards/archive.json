    {
      "id": 7,
      "title": "Filter: share of LLM runs with a hit",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "gridPos": {
        "x": 0,
