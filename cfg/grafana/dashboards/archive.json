    {
      "id": 3,
      "title": "LLM tokens per day, by model",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
